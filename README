            border: 2px solid #ff6347;
        }
        h1 {
            color: #e60000;
        }
        .question {
            font-size: 1.2em;
            margin-bottom: 20px;
        }
        .options {
            margin-bottom: 20px;
        }
        .options button {
            background-color: #ff1493;
            color: white;
            font-size: 1em;
            padding: 10px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            width: 100%;
            margin-bottom: 10px;
            transition: background-color 0.3s;
        }
        .options button:hover {
            background-color: #ff6347;
        }
        #secretMessage {
            display: none;
            color: #ff1493;
            font-size: 2em;
            font-weight: bold;
            margin-top: 20px;
            animation: pop 0.5s ease-in-out;
        }
        @keyframes pop {
            0% { transform: scale(0); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }
        .next-btn {
            background-color: #32cd32;
            color: white;
            padding: 10px 20px;
            font-size: 1em;
